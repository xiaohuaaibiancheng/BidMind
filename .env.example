# -------------------------
# BidMind Web Runtime Config
# -------------------------

# API Port (default: 8788)
BIDMIND_WEB_API_PORT=8788

# Local data root (default: ./.web-data ; on Vercel defaults to /tmp/bidmind-web-data)
BIDMIND_DATA_ROOT=.web-data

# -------------------------
# Storage Drivers (default all local)
# -------------------------
# auth: local | mysql
BIDMIND_AUTH_DRIVER=local
# state: local | mysql
BIDMIND_STATE_DRIVER=local
# blob: local | minio
BIDMIND_BLOB_DRIVER=local
# events: local | redis
BIDMIND_EVENT_DRIVER=local

# -------------------------
# MySQL (for auth/state when driver=mysql)
# -------------------------
BIDMIND_MYSQL_ENABLED=false
BIDMIND_MYSQL_HOST=127.0.0.1
BIDMIND_MYSQL_PORT=3306
BIDMIND_MYSQL_USER=root
BIDMIND_MYSQL_PASSWORD=
BIDMIND_MYSQL_DATABASE=bidmind
BIDMIND_MYSQL_POOL_SIZE=10
BIDMIND_MYSQL_TIMEZONE=Z

# -------------------------
# MinIO (for blob when driver=minio)
# -------------------------
BIDMIND_MINIO_ENABLED=false
BIDMIND_MINIO_ENDPOINT=127.0.0.1
BIDMIND_MINIO_PORT=9000
BIDMIND_MINIO_USE_SSL=false
BIDMIND_MINIO_ACCESS_KEY=minioadmin
BIDMIND_MINIO_SECRET_KEY=minioadmin
BIDMIND_MINIO_BUCKET=bidmind
BIDMIND_MINIO_PREFIX=app
BIDMIND_MINIO_REGION=

# -------------------------
# Redis (for events when driver=redis)
# -------------------------
BIDMIND_REDIS_ENABLED=false
BIDMIND_REDIS_URL=redis://127.0.0.1:6379
BIDMIND_REDIS_PREFIX=bidmind:
